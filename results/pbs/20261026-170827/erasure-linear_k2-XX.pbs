#!/bin/bash
#PBS -N erasure-linear_k2-XX
#PBS -l select=1:ncpus=4:mem=15gb
#PBS -l walltime=02:00:00
#PBS -j oe
#PBS -o /rds/general/user/ftb123/home/dizx/results/pbs/20261026-170827/logs/erasure-linear_k2-XX.log

cd /rds/general/user/ftb123/home/dizx
module load tools/prod Python/3.12.3-GCCcore-13.3.0; source .venv/bin/activate
set -eo pipefail
export OMP_NUM_THREADS=1 OPENBLAS_NUM_THREADS=1 MKL_NUM_THREADS=1
echo "job $PBS_JOBID on $(hostname), $(date), commit $(git rev-parse --short HEAD 2>/dev/null)"
python experiments/cluster.py run /rds/general/user/ftb123/home/dizx/results/pbs/20261026-170827/erasure-linear_k2-XX.json --workers 4
